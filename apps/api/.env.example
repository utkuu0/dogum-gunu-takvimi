# Postgres (docker-compose ile lokal geliştirme)
POSTGRES_USER=dogumgunu
POSTGRES_PASSWORD=dogumgunu
POSTGRES_DB=dogumgunu

# Prisma / NestJS veritabanı bağlantısı — api lokalde çalışıyor,
# docker-compose'daki postgres'e published port üzerinden bağlanıyor
DATABASE_URL="postgresql://dogumgunu:dogumgunu@localhost:5432/dogumgunu?schema=public"

# Redis (docker-compose ile lokal geliştirme — ileride BullMQ için)
REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000
NODE_ENV=development

# Google OAuth — Google Cloud Console'daki 3 ayrı client ID (aynı projede)
# Kurulum adımları için README'ye bak
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Kendi JWT çiftimiz — access kısa ömürlü, refresh uzun ömürlü, ayrı secret'lar
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Firebase service account JSON'ının tamamı base64 ile kodlanmış hali — kurulum için README'ye bak.
# Boş bırakılırsa FCM bildirimleri devre dışı kalır (sadece loglanır), uygulama çökmez.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google Photos Picker API — incremental authorization (Adım 9, opsiyonel).
# code exchange'i PKCE public client (Android/iOS client ID, secretsiz) ile yapılıyor,
# bu yüzden ayrı bir client secret gerekmiyor. redirectUri mobil tarafla birebir eşleşmeli.
GOOGLE_PHOTOS_REDIRECT_URI=dogumgunu://google-photos-redirect
