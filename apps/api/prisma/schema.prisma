// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  googleId  String   @unique
  fcmToken  String?
  /** IANA zaman dilimi (örn. "Europe/Istanbul") — bildirim zamanlaması bunu kullanır */
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  friends Friend[]
  googlePhotosAuthorization GooglePhotosAuthorization?
}

/// Google Photos Picker API için incremental authorization ile alınan token'lar.
/// Sadece kullanıcı "Google Photos'tan seç" özelliğini açtığında oluşur.
model GooglePhotosAuthorization {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Friend {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  birthDate DateTime
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
}
