{
  "name": "@dogum-gunu/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild",
    "eas-build-post-install": "pnpm --filter @dogum-gunu/shared build",
    "build": "expo export --platform android --platform ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dogum-gunu/shared": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "base64-js": "^1.5.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.8",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.29",
    "expo-web-browser": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-background-actions": "^4.1.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/face-detection",
          "react-native-fast-tflite",
          "react-native-background-actions"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
