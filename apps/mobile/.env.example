# Backend API adresi. Simülatör/emülatörde "localhost" çalışır; fiziksel cihazda
# bilgisayarının aynı Wi-Fi ağındaki LAN IP'sini kullanman gerekir (örn. http://192.168.1.115:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In — Google Cloud Console'daki Web client ID (README'ye bak).
# SDK, idToken'ı bu ID'ye göre imzalıyor; Android/iOS client ID'leri native tarafta
# (google-services.json / GoogleService-Info.plist ile) otomatik eşleşiyor.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Photos Picker API (Adım 9, opsiyonel) — incremental authorization için platform
# client ID'leri (Web değil, PKCE public client olarak Android/iOS client ID kullanılıyor).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
