# pnpm'in varsayılan "isolated" linker'ı paketleri node_modules/.pnpm altında
# "<paket>@<versiyon>_<hash>/node_modules/<paket>/..." gibi uzun, iç içe adlarla tutuyor.
# react-native-reanimated gibi CMake ile derlenen native modüllerde, kendi klasörü dışındaki
# (Common/cpp/...) kaynak dosyalar için CMake bu TÜM mutlak yolu ikinci kez dosya adının
# içine gömüyor — bu yüzden pnpm-store'u ne kadar kısa bir yola taşırsak taşıyalım (hatta
# C:\ kökünde bile) toplam yol Windows/CMake'in 250 karakter sınırını aşıp
# "ninja: manifest still dirty after 100 tries" hatasına yol açıyordu.
#
# hoisted linker, .pnpm sanal deposunu ve @versiyon_hash son eklerini tamamen kaldırıp
# npm/yarn tarzı düz bir node_modules üretiyor — asıl şişirici (61 karakterlik paket@hash
# adı, iki kez tekrarlanıyordu) böylece ortadan kalkıyor.
node-linker=hoisted
virtual-store-dir=C:/pnpm-store/dgt
