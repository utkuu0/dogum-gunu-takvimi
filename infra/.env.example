# Production ortam dosyası — bunu kopyalayıp infra/.env olarak VPS'te doldur.
# infra/.env asla commit edilmez (kök .gitignore'daki ".env" kuralı zaten kapsıyor).

# --- docker-compose.prod.yml'nin kendi kullandığı değişkenler ---
POSTGRES_USER=dogumgunu
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dogumgunu

# Caddy'nin otomatik HTTPS sertifikası aldığı gerçek alan adı (örn. api.dogumgunu.app).
# DNS A kaydı bu VPS'in IP'sine işaret etmeli.
DOMAIN=api.example.com

# --- apps/api runtime env'i (bkz. apps/api/.env.example — DATABASE_URL, REDIS_HOST/PORT,
#     NODE_ENV hariç hepsi aynı; onlar docker-compose.prod.yml içinde servis adlarına göre
#     otomatik hesaplanıyor) ---
PORT=3000

GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

FIREBASE_SERVICE_ACCOUNT_BASE64=

GOOGLE_PHOTOS_REDIRECT_URI=dogumgunu://google-photos-redirect
